#!/bin/sh

#############################
##          All            ##
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export SHELL=/bin/bash
export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11

#############################
## u-kex: per-user override ##
## Put your own session script in ~/.config/u-kex/xstartup (make it executable)
## to run a different desktop in window mode without editing this system file.
## Seamless mode (--sl) still requires XFCE.
if [ -x "$HOME/.config/u-kex/xstartup" ]; then
    exec "$HOME/.config/u-kex/xstartup"
fi

